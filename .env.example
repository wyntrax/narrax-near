# NARRAX — NEAR research desk
# Copy this file to .env and fill the blanks. Secrets never belong in git.

PROJECT_NAME=NARRAX

# Data stores
DATABASE_URL=postgresql://narra:narra@localhost:5432/narra
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000

# NEAR. Testnet is the default: an unset or misspelled network can never point at mainnet.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_EXPLORER_URL=https://testnet.nearblocks.io
# Optional wrapped-NEAR contract used for the reference price. Leave blank for wrap.near.
NEAR_WRAP_CONTRACT=

# Who is an admin. When either is set, the server environment is the single source of truth:
# exactly these accounts are admin and a leftover database isAdmin flag is ignored.
# ADMIN_PRIVY_USER_ID is the did:privy:... id from the verified sign-in token.
ADMIN_PRIVY_USER_ID=
# ADMIN_EMAIL matches a signature-verified email, lowercased. A typed address is never trusted.
ADMIN_EMAIL=

# Server-side secrets only. Never expose these to the browser.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
# Optional. Defaults to Privy's documented app JWKS endpoint. Used only when a rotated key no longer matches the PEM above.
PRIVY_JWKS_URL=
AI_PROVIDER_API_KEY=
# OpenAI-compatible provider used by the agent chat and analysis pipeline.
AI_BASE_URL=https://api.vikey.ai/v1
# A model id your provider lists for this key. Saved admin AI settings win.
AI_MODEL_ID=
# standard (default) | bare | full — see docs/AI_PROVIDER.md
AI_REQUEST_STYLE=standard

# Telegram Early Radar delivery (global research alerts only).
# Leave the token and chat id empty to disable delivery. The CLI defaults to a dry run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional delivery limits. Set TELEGRAM_ENABLED=false to disable without removing the credentials.
TELEGRAM_MAX_AGE_MIN=15
TELEGRAM_MAX_PER_RUN=10
TELEGRAM_SEND_DELAY_MS=1200

# Market data (public APIs, no key).
MARKET_DATA_ENABLED=true
DEXSCREENER_BASE_URL=
GECKOTERMINAL_BASE_URL=

# Observed smart-money research (public GeckoTerminal NEAR pool trades, no key).
# History starts when collection starts; the public trade feed is a recent window, not a full archive.
SMART_MONEY_ENABLED=true
# GeckoTerminal's NEAR market is mainnet. Keep this separate from a testnet NEAR_RPC_URL.
# The worker falls back to https://rpc.mainnet.near.org if this endpoint fails.
SMART_MONEY_ACCOUNT_RPC_URL=https://free.rpc.fastnear.com
SMART_MONEY_MAX_POOLS=20
SMART_MONEY_INTERVAL_MS=600000
SMART_MONEY_MIN_CLOSED_TRADES=5
SMART_MONEY_MIN_CLOSED_TOKENS=2
SMART_MONEY_MIN_OBSERVED_HOURS=24
SMART_MONEY_MIN_VOLUME_USD=100
SMART_MONEY_MIN_SCORE=60

# Social narrative ingestion (Treg). Leave disabled to run without a provider.
TREG_NARRATIVE_ENABLED=false
TREG_TOKEN=
TREG_NARRATIVE_PACKS=near
TREG_NARRATIVE_TOPICS=
TREG_NARRATIVE_PLATFORMS=x
TREG_NARRATIVE_INTERVAL_MS=300000
TREG_MAX_COST_USD=0.01

# API hardening and realtime
# Exact browser origins allowed to call the API and open the WebSocket, comma separated.
CORS_ORIGINS=
# True only behind a reverse proxy you control (rate limits use the client address).
TRUST_PROXY=false
# True only when the API is served over HTTPS.
HSTS=false
REALTIME_STREAM_KEY=narrax:events
