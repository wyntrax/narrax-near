// NARRA data model for a NEAR-only research deployment.
// Money and prices use Decimal. Scores and ratios use Float.
// No private keys or signing material are stored.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DecisionAction {
  BUY
  WATCH
  HOLD
  REDUCE
  SELL
  IGNORE
}

enum NarrativeStage {
  SEED
  EMERGING
  ACCELERATING
  MAINSTREAM
  SATURATED
  DECAYING
  DEAD
}

enum TokenRelation {
  OG
  PRIMARY
  DERIVATIVE
  MEME_EXPRESSION
  UNRELATED
  SUSPICIOUS
}

enum CreatorRole {
  ORIGINATOR
  EARLY_AMPLIFIER
  FOLLOWER
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum AlertPriority {
  INFO
  WATCH
  IMPORTANT
  CRITICAL
}

enum ChatRole {
  USER
  ASSISTANT
}

enum OutcomeLabel {
  WIN
  LOSS
  FLAT
  UNKNOWN
}

enum SmartTradeSide {
  BUY
  SELL
}

enum SmartWalletStatus {
  QUALIFIED
  PROVISIONAL
  INSUFFICIENT
}

// ---------- Users and local access ----------

model User {
  id              String              @id @default(cuid())
  privyUserId     String              @unique
  email           String?
  interests       String[]
  isAdmin         Boolean             @default(false)
  createdAt       DateTime            @default(now())
  alerts          Alert[]
  notifications   Notification[]
  agentDecisions  AgentDecision[]
  auditLogs       AuditLog[]
  chats           ChatConversation[]
  settings        UserSettings?
  accessGrants    AccessGrant[]
  researchMonitors ResearchMonitor[]
  personalBriefs  PersonalBrief[]
}

/// Private PRO research definitions. Updates reset the evaluation cursor, not the history.
model ResearchMonitor {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String
  name            String
  thesis          String
  mint            String?
  narrativeSlug   String?
  rules           Json
  active          Boolean              @default(true)
  revision        Int                  @default(1)
  lastEvaluatedAt DateTime?
  lastRun         Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  observations    ResearchObservation[]

  @@index([userId, kind, createdAt])
  @@index([active, lastEvaluatedAt])
}

model ResearchObservation {
  id         String           @id @default(cuid())
  monitorId  String
  monitor    ResearchMonitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  mint       String
  revision   Int
  status     String
  evaluation Json
  at         DateTime
  bucket     String
  alerted    Boolean          @default(false)

  @@unique([monitorId, mint, revision, bucket])
  @@index([monitorId, at])
}

model PersonalBrief {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         String
  content     Json
  generatedAt DateTime

  @@unique([userId, day])
}

/// Per-user preferences. A user without a row gets the defaults named in packages/shared (alerts.ts).
model UserSettings {
  id               String        @id @default(cuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String?
  /// IANA time zone name, validated at the API.
  timezone         String?
  /// DARK, LIGHT or SYSTEM
  theme            String        @default("DARK")
  /// COMFORTABLE or COMPACT
  density          String        @default("COMFORTABLE")
  reducedMotion    Boolean       @default(false)
  /// Global alerts below this priority do not become notifications. Alerts that belong to the user are always delivered.
  minAlertPriority AlertPriority @default(WATCH)
  mutedAlertKinds  String[]
  updatedAt        DateTime      @updatedAt
}

// Entitlements are independent of custody and trading permissions.
enum LocalAccessTier {
  EARLY_ACCESS
}

enum AccessGrantSource {
  EARLY_ACCESS
  ADMIN
}

enum AccessGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model AccessGrant {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     AccessGrantSource
  tier       LocalAccessTier   @default(EARLY_ACCESS)
  status     AccessGrantStatus @default(ACTIVE)
  validUntil DateTime?
  revokedAt  DateTime?
  createdBy  String?
  reason     String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([userId, source])
  @@index([tier, status, validUntil])
}

// ---------- Creators and narratives ----------

model Creator {
  id         String             @id @default(cuid())
  platform   String
  handle     String
  createdAt  DateTime           @default(now())
  metrics    CreatorMetric[]
  narratives NarrativeCreator[]

  @@unique([platform, handle])
}

model CreatorMetric {
  id                 String   @id @default(cuid())
  creatorId          String
  creator            Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorScore       Float
  leadScore          Float
  amplificationScore Float
  hitRate            Float
  medianLeadSeconds  Int?
  computedAt         DateTime @default(now())
}

model Narrative {
  id              String                   @id @default(cuid())
  name            String
  slug            String                   @unique
  summary         String?
  stage           NarrativeStage           @default(SEED)
  score           Float                    @default(0)
  velocity        Float                    @default(0)
  acceleration    Float                    @default(0)
  organicScore    Float                    @default(0)
  saturationRisk  Float                    @default(0)
  firstDetectedAt DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  metrics         NarrativeMetric[]
  sources         NarrativeSource[]
  mentions        NarrativeMention[]
  creators        NarrativeCreator[]
  tokens          NarrativeTokenRelation[]
  opportunities   Opportunity[]
}

model NarrativeMetric {
  id                    String    @id @default(cuid())
  narrativeId           String
  narrative             Narrative @relation(fields: [narrativeId], references: [id], onDelete: Cascade)
  score                 Float
  velocity              Float
  acceleration          Float
  organicScore          Float
  manipulationRisk      Float
  mentionVelocity       Float
  creatorVelocity       Float
  engagementVelocity    Float
  at                    DateTime  @default(now())

  @@index([narrativeId, at])
  @@index([at])
}

model NarrativeSource {
  id          String    @id @default(cuid())
  narrativeId String
  narrative   Narrative @relation(fields: [narrativeId], references: [id], onDelete: Cascade)
  provider    String
  externalRef String?

  @@unique([narrativeId, provider])
  @@index([narrativeId])
}

model NarrativeMention {
  id             String    @id @default(cuid())
  narrativeId    String
  narrative      Narrative @relation(fields: [narrativeId], references: [id], onDelete: Cascade)
  platform       String
  creatorId      String?
  externalId     String
  textHash       String
  simhash        String
  creatorAgeDays Int?
  engagement     Int       @default(0)
  at             DateTime

  @@unique([narrativeId, platform, externalId])
  @@index([narrativeId, at])
}

/// A token reference (contract id or $CASHTAG) found in a social post. Only the extracted reference and hashes are
/// stored. Raw post text is never stored. Rows older than the retention window are pruned by the social-token scan.
model TokenMention {
  id             String   @id @default(cuid())
  /// 'CONTRACT' (strong: names one NEAR token contract) or 'CASHTAG' (weak: any token can use any symbol)
  refKind        String
  /// the NEAR account id of the token contract, or the symbol upper-cased without the dollar sign
  ref            String
  platform       String
  externalId     String
  creatorId      String?
  textHash       String
  simhash        String
  creatorAgeDays Int?
  engagement     Int      @default(0)
  at             DateTime

  @@unique([refKind, ref, platform, externalId])
  @@index([ref, at])
  @@index([at])
}

model NarrativeCreator {
  id          String    @id @default(cuid())
  narrativeId String
  narrative   Narrative @relation(fields: [narrativeId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  role        CreatorRole

  @@unique([narrativeId, creatorId])
}

model NarrativeTokenRelation {
  id          String     @id @default(cuid())
  narrativeId String
  narrative   Narrative  @relation(fields: [narrativeId], references: [id], onDelete: Cascade)
  tokenId     String
  token       Token      @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  relation    TokenRelation
  ogScore     Float
  matchScore  Float
  confidence  Float

  @@unique([narrativeId, tokenId])
}

// ---------- Tokens ----------

model Token {
  id               String                   @id @default(cuid())
  /// NEAR account id of the NEP-141 contract.
  mint             String                   @unique
  symbol           String
  name             String
  createdOnChainAt DateTime?
  deployer         String?
  blacklisted      Boolean                  @default(false)
  /// Why an admin blacklisted it, when, and who. Cleared when it is un-blacklisted (the change itself stays in the audit log).
  blacklistReason  String?
  blacklistedAt    DateTime?
  blacklistedBy    String?
  metrics          TokenMetric[]
  holders          TokenHolderMetric[]
  risk             TokenRiskMetric[]
  narratives       NarrativeTokenRelation[]
  opportunities    Opportunity[]
  smartTrades      SmartWalletTrade[]

  @@index([symbol])
}

model TokenMetric {
  id           String   @id @default(cuid())
  tokenId      String
  token        Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  priceUsd     Decimal
  marketCapUsd Decimal
  liquidityUsd Decimal
  volume24hUsd Decimal
  at           DateTime @default(now())

  @@index([tokenId, at])
}

model TokenHolderMetric {
  id        String   @id @default(cuid())
  tokenId   String
  token     Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  holders   Int
  top10Pct  Float
  at        DateTime @default(now())

  @@index([tokenId, at])
}

model TokenRiskMetric {
  id        String   @id @default(cuid())
  tokenId   String
  token     Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  riskScore Float
  flags     String[]
  at        DateTime @default(now())

  @@index([tokenId, at])
}

// ---------- Observed smart-money wallets ----------
// Only public DEX observations. No private keys, balances, orders or execution data.
// A wallet profile is a cost-basis calculation over the trades this deployment actually observed.

model SmartWallet {
  id          String              @id @default(cuid())
  /// NEAR account id of the trader observed in a DEX swap.
  address     String              @unique
  firstSeenAt DateTime
  lastTradeAt DateTime
  trades      SmartWalletTrade[]
  profile     SmartWalletProfile?

  @@index([lastTradeAt])
}

model SmartWalletTrade {
  id           String         @id @default(cuid())
  walletId     String
  wallet       SmartWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tokenId      String
  token        Token          @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  /// Provider name. Kept so a later source can be distinguished without rewriting history.
  source       String
  /// Provider trade id. The unique key makes overlapping poll windows idempotent.
  externalId   String         @unique
  poolAddress  String
  txHash       String
  side         SmartTradeSide
  /// Token units received on a BUY and sent on a SELL, as reported by the source.
  tokenAmount  Decimal        @db.Decimal(38, 18)
  priceUsd     Decimal?       @db.Decimal(38, 18)
  /// USD value of the swap leg at trade time, as reported by the source. Never estimated from a current price.
  valueUsd     Decimal        @db.Decimal(38, 18)
  at           DateTime
  observedAt   DateTime       @default(now())

  @@index([walletId, at])
  @@index([tokenId, at])
  @@index([at])
}

model SmartWalletProfile {
  walletId         String            @id
  wallet           SmartWallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  updatedAt        DateTime          @default(now())
  tradeCount       Int
  buyCount         Int
  sellCount        Int
  volumeUsd        Decimal           @db.Decimal(38, 2)
  totalBoughtUsd   Decimal           @db.Decimal(38, 2)
  realizedPnlUsd   Decimal           @db.Decimal(38, 2)
  closedTrades     Int
  closedTokens     Int
  winningTrades    Int
  losingTrades     Int
  winRate          Float?
  medianRoi        Float?
  profitFactor     Float?
  maxDrawdown      Float?
  score            Float?
  status           SmartWalletStatus
  eligible         Boolean           @default(false)
  /// Machine-readable reasons behind the status, shown in the wallet detail.
  reasons          String[]
  unmatchedSells   Int
  excessSellUnits  Int
  observedFrom     DateTime?
  observedTo       DateTime?

  @@index([eligible, score])
  @@index([realizedPnlUsd])
}

// ---------- Opportunities, AI and outcomes ----------

model Opportunity {
  id              String          @id @default(cuid())
  tokenId         String
  token           Token           @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  narrativeId     String?
  narrative       Narrative?      @relation(fields: [narrativeId], references: [id])
  score           Float
  narrativeScore  Float
  liquidityScore  Float
  momentumScore   Float
  ogScore         Float
  riskScore       Float
  attentionGrowth Float?
  priceGrowth     Float?
  createdAt       DateTime        @default(now())
  analyses        AgentAnalysis[]

  @@index([tokenId, createdAt])
  @@index([createdAt])
}

model AgentAnalysis {
  id                 String          @id @default(cuid())
  opportunityId      String
  opportunity        Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fastClassification String?
  fastScore          Float?
  bullCase           Json?
  bearCase           Json?
  riskCase           Json?
  model              String
  inputTokens        Int?
  outputTokens       Int?
  createdAt          DateTime        @default(now())
  decisions          AgentDecision[]
}

model AgentDecision {
  id         String          @id @default(cuid())
  analysisId String
  analysis   AgentAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?           @relation(fields: [userId], references: [id])
  action     DecisionAction
  confidence Float
  payload    Json
  createdAt  DateTime        @default(now())
  outcome    DecisionOutcome?

  @@index([userId, createdAt])
  @@index([createdAt])
}

model DecisionOutcome {
  id              String        @id @default(cuid())
  decisionId      String        @unique
  decision        AgentDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  /// Measured on the 24h price return, before costs. UNKNOWN until measurable, and when no price exists near the 24h mark.
  label           OutcomeLabel  @default(UNKNOWN)
  returnPct1h     Float?
  returnPct24h    Float?
  leadTimeSeconds Int?
  entryPriceUsd   Float?
  maxGainPct      Float?
  maxDrawdownPct  Float?
  isFinal         Boolean       @default(false)
  unknownReason   String?
  measuredAt      DateTime      @default(now())

  @@index([isFinal, measuredAt])
}

// ---------- Alerts, chat, settings, audit ----------

model Alert {
  id           String         @id @default(cuid())
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String
  priority     AlertPriority
  title        String
  body         String
  refType      String?
  refId        String?
  createdAt    DateTime       @default(now())
  /// Set once the dispatcher has turned the alert into notifications and published it. Null means not yet handled.
  dispatchedAt DateTime?
  notifications Notification[]
  earlyRadarOutcome EarlyRadarOutcome?

  @@index([userId, createdAt])
  @@index([dispatchedAt, createdAt])
}

/// Research-only frozen cohort for early-radar alerts. Legacy alerts retain UNKNOWN attribution.
model EarlyRadarOutcome {
  id                  String   @id @default(cuid())
  alertId             String   @unique
  alert               Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  tokenId             String
  mint                String?
  alertedAt           DateTime
  profile             String
  tier                String
  route               String
  matchKind           String
  score               Float?
  entryMetricId       String?
  entryAt             DateTime?
  entryPriceUsd       Float?
  entryMarketCapUsd   Float?
  entryMarketCapIsFdv Boolean?
  entrySource         String?
  entryUnknownReason  String?
  measurements        EarlyRadarMeasurement[]

  @@index([alertedAt, id])
  @@index([tokenId, alertedAt])
}

/// A missing horizon becomes UNKNOWN after its observation window closes; it is never a zero return.
model EarlyRadarMeasurement {
  id             String            @id @default(cuid())
  outcomeId      String
  outcome        EarlyRadarOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  horizonHours   Int
  targetAt       DateTime
  nextCheckAt    DateTime
  status         String            @default("PENDING")
  metricId       String?
  observedAt     DateTime?
  priceUsd       Float?
  marketCapUsd   Float?
  marketCapIsFdv Boolean?
  source         String?
  returnPct      Float?
  unknownReason  String?
  measuredAt     DateTime?

  @@unique([outcomeId, horizonHours])
  @@index([status, nextCheckAt, id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertId   String
  alert     Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, alertId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([alertId])
  @@index([createdAt])
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

/// Only what the user typed and what the agent finally said, both sanitized text. Tool results are never stored,
/// so text from the internet cannot be carried into a later turn through history.
model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  role           ChatRole
  content        String
  inputTokens    Int              @default(0)
  outputTokens   Int              @default(0)
  model          String?
  meta           Json?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
