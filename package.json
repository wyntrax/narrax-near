{
  "name": "narrax-near",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "test": "vitest run",
    "check-privy": "tsx scripts/check-privy.ts",
    "narratives:treg": "node --require ./apps/web/scripts/no-env-files.cjs --import tsx scripts/treg-narratives.ts",
    "early-radar:report": "node --require ./apps/web/scripts/no-env-files.cjs --import tsx scripts/early-radar-report.ts",
    "narratives:link-tokens": "node --require ./apps/web/scripts/no-env-files.cjs --import tsx scripts/link-narrative-tokens.ts",
    "research:coverage": "node --require ./apps/web/scripts/no-env-files.cjs --import tsx scripts/research-coverage.ts",
    "thesis:report": "tsx --env-file=.env scripts/thesis-report.ts",
    "telegram:send": "node --require ./apps/web/scripts/no-env-files.cjs --import tsx scripts/telegram-send.ts",
    "settings": "tsx scripts/settings.ts",
    "near:status": "tsx scripts/near-status.ts",
    "agent:risk": "tsx scripts/agent-risk.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "entitlements:expire": "tsx --env-file=.env scripts/entitlements-expire.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @narra/web",
    "dev:web": "npm run dev -w @narra/web",
    "dev:api": "tsx --env-file=.env apps/api/src/server.ts",
    "dev:personal-research": "tsx --env-file=.env apps/api/src/personalResearchWorker.ts",
    "dev:workers": "tsx --env-file=.env workers/pipeline/src/main.ts",
    "dev:narratives": "node --require ./apps/web/scripts/no-env-files.cjs --import tsx workers/pipeline/src/narrativesMain.ts",
    "dev:market": "node --require ./apps/web/scripts/no-env-files.cjs --import tsx workers/pipeline/src/marketMain.ts",
    "video:studio": "npm run studio -w @narra/video",
    "video:render": "npm run render -w @narra/video"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
